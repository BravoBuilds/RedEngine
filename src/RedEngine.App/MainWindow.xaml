<Window x:Class="RedEngine.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="redENGINE" Height="650" Width="900" MinHeight="560" MinWidth="760"
 WindowStartupLocation="CenterScreen" Background="#080808" Foreground="#F7F7F8">
 <Window.Resources>
  <Style x:Key="Tile" TargetType="{x:Type Button}">
   <Setter Property="Height" Value="90"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Background" Value="#F0141519"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#555B66"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type Button}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/></Grid.RowDefinitions>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Grid.Row="1" Background="#E60028"/>
       </Grid>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type Button}">
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Background" Value="#262A32"/>
   <Setter Property="Foreground" Value="#F7F7F8"/>
   <Setter Property="BorderBrush" Value="#505866"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#080808" Padding="18,10" BorderBrush="#252525" BorderThickness="0,0,0,1">
   <DockPanel><TextBlock Text="redENGINE" FontSize="23" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="HOME TO TOGGLE" Foreground="#B9C0CA" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="24" Background="#080808">
   <StackPanel x:Name="HomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Width="74" Height="74" BorderBrush="#E60028" BorderThickness="1" Background="#0B0B0B" HorizontalAlignment="Center" Margin="0,0,0,8">
     <Grid><TextBlock Text="E" Foreground="#E60028" FontSize="58" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-28,0,0,0"/><TextBlock Text="R" Foreground="White" FontSize="86" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0"/></Grid>
    </Border>
    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4"><Run Text="red" Foreground="#E60028"/><Run Text="ENGINE" Foreground="#F2F2F2"/></TextBlock>
    <TextBlock Text="Launcher ready" Foreground="#777777" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,18"/>
    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,22">
     <Button Content="Inject" Click="Inject_Click" Width="150" Height="38" Margin="4" Background="#E60028" Foreground="White" BorderBrush="#E60028" FontWeight="SemiBold" Cursor="Hand"/>
     <Button Content="Launch Roblox" Click="LaunchRoblox_Click" Width="150" Height="38" Margin="4" Background="#151515" Foreground="White" BorderBrush="#444444" FontWeight="SemiBold" Cursor="Hand"/>
    </WrapPanel>
    <UniformGrid Columns="5" Rows="2" MaxWidth="700">
     <Button Content="〈/〉&#x0a;Executor" Tag="Executor" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="▰&#x0a;Dumper" Tag="Dumper" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="☷&#x0a;Resources" Tag="Resources" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="▤&#x0a;Menus" Tag="Menus" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="⚙&#x0a;Settings" Tag="Settings" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="⬡&#x0a;Misc" Tag="Misc" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="●●&#x0a;Chat" Tag="Chat" Click="Navigate_Click" Style="{StaticResource Tile}"/>
    </UniformGrid>
   </StackPanel>
   <Border x:Name="ModulePanel" Visibility="Collapsed" Background="#F013151A" Padding="18" BorderBrush="#66FFFFFF" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button Content="← Home" DockPanel.Dock="Right" Click="Home_Click" Padding="12,5"/><TextBlock x:Name="ModuleTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="1">
      <Grid x:Name="ExecutorView" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
       <WrapPanel Margin="0,0,0,8"><Button Content="New" Click="New_Click"/><Button Content="Open" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Validate" Click="Validate_Click"/><Button Content="Run local Lua" Click="Run_Click"/></WrapPanel>
       <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14" Background="#101216" Foreground="#E9EDF2" Padding="12"/>
       <TextBlock Grid.Row="2" Text="Output / diagnostics" Margin="0,10,0,5"/>
       <TextBox x:Name="Output" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#101216" Foreground="#C9D1D9" Padding="8"/>
      </Grid>
      <ScrollViewer x:Name="InfoView" Visibility="Collapsed"><StackPanel><TextBlock x:Name="Description" TextWrapping="Wrap" FontSize="16"/><TextBlock x:Name="Status" Margin="0,16,0,0" Foreground="#CAD2DE" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#080808" Padding="12,7" BorderBrush="#252525" BorderThickness="0,1,0,0"><DockPanel><TextBlock Text="Local workspace • no remote connection active" Foreground="#D0D5DC"/><TextBlock x:Name="Footer" DockPanel.Dock="Right" Text="Ready"/></DockPanel></Border>
 </Grid>
</Window>
<Window x:Class="RedEngine.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RedEngine" Height="720" Width="1080" MinHeight="560" MinWidth="820"
 WindowStartupLocation="CenterScreen" Background="#8EAEDB" Foreground="#F7F7F8">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#D916171B" Padding="18,10">
   <DockPanel><TextBlock Text="redENGINE" FontSize="23" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="LOCAL DEVELOPMENT WORKSPACE" Foreground="#B9C0CA" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="24">
   <StackPanel x:Name="HomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="RE" FontSize="74" FontWeight="Bold" Foreground="#E60028" HorizontalAlignment="Center"/>
    <TextBlock Text="redENGINE" FontSize="13" CharacterSpacing="220" HorizontalAlignment="Center" Margin="0,0,0,24"/>
    <UniformGrid Columns="5" Rows="2" MaxWidth="700">
     <Button Content="Executor" Tag="Executor" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Dumper" Tag="Dumper" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Resources" Tag="Resources" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Menus" Tag="Menus" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Settings" Tag="Settings" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Misc" Tag="Misc" Click="Navigate_Click" Style="{StaticResource Tile}"/>
     <Button Content="Chat" Tag="Chat" Click="Navigate_Click" Style="{StaticResource Tile}"/>
    </UniformGrid>
   </StackPanel>
   <Border x:Name="ModulePanel" Visibility="Collapsed" Background="#F013151A" Padding="18" BorderBrush="#66FFFFFF" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button Content="← Home" DockPanel.Dock="Right" Click="Home_Click" Padding="12,5"/><TextBlock x:Name="ModuleTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="1">
      <Grid x:Name="ExecutorView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
       <WrapPanel Margin="0,0,0,8"><Button Content="New" Click="New_Click" Margin="0,0,8,0"/><Button Content="Open" Click="Open_Click" Margin="0,0,8,0"/><Button Content="Save" Click="Save_Click" Margin="0,0,8,0"/><Button Content="Validate" Click="Validate_Click" Margin="0,0,8,0"/><Button Content="Run local Lua" Click="Run_Click"/></WrapPanel>
       <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14" Background="#101216" Foreground="#E9EDF2" Padding="12"/>
       <TextBlock Grid.Row="2" Text="Output / diagnostics" Margin="0,10,0,5"/>
       <TextBox x:Name="Output" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#101216" Foreground="#C9D1D9" Padding="8"/>
      </Grid>
      <ScrollViewer x:Name="InfoView" Visibility="Collapsed"><StackPanel><TextBlock x:Name="Description" TextWrapping="Wrap" FontSize="16"/><TextBlock x:Name="Status" Margin="0,16,0,0" Foreground="#CAD2DE" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#D916171B" Padding="12,7"><DockPanel><TextBlock Text="Local workspace • no remote connection active" Foreground="#D0D5DC"/><TextBlock x:Name="Footer" DockPanel.Dock="Right" Text="Ready"/></DockPanel></Border>
  <Grid.Resources>
   <Style x:Key="Tile" TargetType="Button"><Setter Property="Height" Value="90"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#F0141519"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#555B66"/><Setter Property="FontSize" Value="15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/></Grid.RowDefinitions><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Grid.Row="1" Background="#E60028"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
 </Grid>
</Window>